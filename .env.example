# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-publishable-or-anon-key
NEXT_PUBLIC_DISABLE_SUPABASE_AUTH=
NEXT_PUBLIC_AMPLITUDE_API_KEY=optional-public-amplitude-key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=optional-public-turnstile-site-key

# Backend
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-public-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-only-in-render-never-frontend
APP_ENCRYPTION_KEY=optional-local-fernet-key
DEMO_AUTH=true
ALLOW_DEMO_DATA=false

# Job API
ADZUNA_APP_ID=optional
ADZUNA_APP_KEY=optional
ADZUNA_COUNTRY=sg
APIFY_MCF_RUN_URL=optional-singapore-mycareersfuture-actor-url
APIFY_API_TOKEN=optional-apify-token
APIFY_MCF_COUNTRY=Singapore

# AI providers and monitoring
OPENAI_API_KEY=optional-openai-api-key
GROQ_API_KEY=optional
HELICONE_API_KEY=optional
LANGFUSE_PUBLIC_KEY=optional-local-only
LANGFUSE_SECRET_KEY=optional-local-only
TURNSTILE_SECRET_KEY=optional-free-bot-protection

# Cost controls
DEFAULT_JOB_LIMIT=30
MAX_JOB_LIMIT=40
MAX_UPLOAD_BYTES=5242880
DAILY_MATCH_LIMIT=20
MODEL_CALL_TIMEOUT_SECONDS=40
MODEL_TASK_BUDGET_SECONDS=100
CHEAP_MODEL=gpt-5.6-luna
STRONG_MODEL=
